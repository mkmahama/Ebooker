# --- Core ---
PUBLIC_URL=https://shop.example.com        # public HTTPS origin of this server (web page + webhook)
PORT=3000
DB_PATH=data/dropshelf.db

# --- Telegram bot (Stars only) ---
BOT_TOKEN=123456:ABC...                    # from @BotFather
BOT_USERNAME=YourShelfBot
BOT_MODE=webhook                           # webhook | polling | off
WEBHOOK_SECRET=change-me-long-random       # sent by Telegram in X-Telegram-Bot-Api-Secret-Token
CHANNEL_ID=@YourShelf                      # launch posts go here (bot must be a channel admin)

# --- /paysupport ---
SUPPORT_CHAT_ID=-1001234567890             # staff group; the bot must be a member (admin for topics)
SUPPORT_USE_TOPICS=true                    # one forum topic per ticket (group must have Topics enabled)
SUPPORT_CONTACT_URL=https://t.me/your_support_username   # /help "Contact us" button

# --- Referrals ---
REFERRAL_TARGET=3
REFERRAL_REWARD_SLUG=first-ai-workflow-weekend

# --- Pricing ---
LAUNCH_HOURS=48
INVOICE_TTL_HOURS=24

# --- TON web checkout ---
TON_WALLET_ADDRESS=UQ...                   # receiving wallet
TON_NETWORK=mainnet                        # mainnet | testnet
TONCENTER_API=https://toncenter.com/api/v2 # testnet: https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
TON_POLL_SECONDS=10
TON_ORDER_TTL_MINUTES=60
TON_PRICING_MODE=fixed                     # fixed (uses TON_USD_RATE) | usd_peg (refreshes TON/USD on a schedule)
TON_USD_RATE=3.0
STAR_USD=0.013
TON_DISCOUNT=0.12
TON_RATE_REFRESH_HOURS=6

# --- Downloads ---
DOWNLOAD_SECRET=change-me-long-random      # HMAC key for signed, expiring web download links
DOWNLOAD_TTL_HOURS=24
