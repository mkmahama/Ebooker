# ---------- Telegram ----------
# Token from @BotFather. Stars payments need no provider token.
BOT_TOKEN=123456:ABC-your-token
# Bot username without @ (used for deep links)
BOT_USERNAME=YourShelfBot
# "polling" for local dev, "webhook" in production (needs PUBLIC_URL over HTTPS)
BOT_MODE=polling
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me-long-random-string
# Private group where /paysupport tickets land (bot must be a member). With Topics enabled and the bot allowed to
# manage topics, each ticket gets its own topic; otherwise admins reply to a ticket message to answer.
SUPPORT_CHAT_ID=-1001234567890
# Optional: Telegram username for the /help "Contact" button (without @)
SUPPORT_USERNAME=YourShelfSupport
# Channel storefront (bot must be an admin that can post), e.g. @YourShelf or -100...
CHANNEL_ID=@YourShelf

# ---------- Web + TON ----------
PORT=8080
# Public HTTPS origin of this server (web checkout, download links, TON Connect manifest, webhook)
PUBLIC_URL=https://shop.example.com
# Secret for signing download links (32+ random chars)
LINK_SECRET=change-me-32-plus-random-characters
# Download links expire after this many minutes
LINK_TTL_MINUTES=60
# Wallet that receives TON payments (user-friendly form, e.g. UQ...)
TON_RECEIVER_ADDRESS=UQ-your-wallet-address
# "mainnet" or "testnet" (test on testnet first)
TON_NETWORK=testnet
# Optional toncenter API key (raises rate limits)
TONCENTER_API_KEY=
# TON pricing: TON per Star before discount, and the web discount (0.12 = 12% cheaper than Stars)
# Update TON_PER_STAR when the TON price moves.
TON_PER_STAR=0.005
TON_DISCOUNT=0.12
# Minutes a TON order stays open, and how often the wallet watcher polls (seconds)
ORDER_TTL_MINUTES=30
WATCH_INTERVAL_SECONDS=10

# ---------- Shop rules ----------
# Qualified referrals (referred users who bought) needed for the free book, and which book it is
REFERRAL_GOAL=3
REFERRAL_REWARD_BOOK_ID=first-ai-workflow

# ---------- Storage ----------
DB_PATH=./data/dropshelf.db
CONTENT_DIR=./content
