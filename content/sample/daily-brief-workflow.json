{
  "name": "AI Daily Brief to Telegram (Drop Shelf starter)",
  "nodes": [
    {
      "parameters": {
        "content": "## AI daily brief\nEvery morning: read your feeds, summarize with AI, send to Telegram.\n\n1. Set your feed URL in **Read feed**.\n2. Add OpenAI credentials to **Chat model**.\n3. Add Telegram credentials and your chat id to **Send brief**.\n\nStarter file from Drop Shelf. Test it before relying on it.",
        "height": 300,
        "width": 360
      },
      "id": "b1d1a0e0-0000-4000-8000-000000000001",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "b1d1a0e0-0000-4000-8000-000000000002",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/frontpage",
        "options": {}
      },
      "id": "b1d1a0e0-0000-4000-8000-000000000003",
      "name": "Read feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
