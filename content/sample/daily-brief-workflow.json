      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "b1d1a0e0-0000-4000-8000-000000000005",
      "name": "Combine items",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short morning brief (max 8 bullets, one line each, plain text) from these headlines. Group related items and say why each matters.\n\n{{ $json.data.map(i => '- ' + i.title + ' (' + i.link + ')').join('\\n') }}"
      },
      "id": "b1d1a0e0-0000-4000-8000-000000000006",
      "name": "Summarize",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
